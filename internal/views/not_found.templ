package views

templ NotFound() {
	@Layout("Página não encontrada — Ludora") {
		<h1 class="text-2xl font-semibold">Página não encontrada</h1>
		<p class="mt-2 text-muted">O jogo que você procurou não existe por aqui.</p>
		<p class="mt-4">
			<a href="/" class="text-accent underline underline-offset-2">Voltar para a home</a>
		</p>
	}
}
