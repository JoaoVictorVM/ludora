package views

import (
	"github.com/JoaoVictorVM/ludora/internal/repository"
	"github.com/JoaoVictorVM/ludora/internal/views/components"
)

templ Home(games []repository.ReviewedGame, nextOffset int, hasMore bool) {
	@Layout("Ludora") {
		<h1 class="text-2xl font-semibold">Ludora</h1>
		<p class="mt-2 text-muted">Avalie e comente jogos, sem cadastro.</p>
		<section class="mt-8">
			<label for="busca" class="block text-sm text-muted">Buscar um jogo</label>
			<input
				id="busca"
				type="search"
				name="q"
				autocomplete="off"
				placeholder="Digite o nome do jogo"
				class="mt-2 w-full rounded border border-border bg-surface px-3 py-2 outline-none focus:border-accent"
				hx-get="/jogos/buscar"
				hx-trigger="keyup changed delay:300ms"
				hx-target="#search-results"
			/>
			<div id="search-results" class="mt-4"></div>
			<div id="form-area" class="mt-6"></div>
		</section>
		<section class="mt-12">
			<h2 class="text-lg font-semibold">Avaliados recentemente</h2>
			if len(games) == 0 {
				<p class="mt-4 text-muted">Nenhum jogo foi avaliado ainda. Seja o primeiro!</p>
			} else {
				<div id="game-grid" class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
					@components.GameCardBatch(games, nextOffset, hasMore)
				</div>
			}
		</section>
	}
}
