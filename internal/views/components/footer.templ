package components

templ Footer() {
	<footer class="border-t border-border">
		<div class="mx-auto w-full max-w-6xl px-4 py-6 text-sm text-muted">
			<p>
				Dados dos jogos fornecidos por
				<a
					href="https://rawg.io"
					target="_blank"
					rel="noopener noreferrer"
					class="text-accent underline underline-offset-2"
				>RAWG</a>
			</p>
		</div>
	</footer>
}
