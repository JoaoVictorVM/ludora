package components

import (
	"fmt"

	"github.com/JoaoVictorVM/ludora/internal/services/rawg"
)

templ SearchResults(query string, results []rawg.SearchResult) {
	if len(results) == 0 {
		<p class="text-sm text-muted">{ fmt.Sprintf("Nenhum jogo encontrado para '%s'. Tente outra busca.", query) }</p>
	} else {
		<ul class="flex flex-col gap-2">
			for _, result := range results {
				<li>
					@SearchResultCard(result)
				</li>
			}
		</ul>
	}
}

templ SearchError(message string) {
	<p class="text-sm text-muted">{ message }</p>
}
