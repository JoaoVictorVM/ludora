package components

import (
	"strconv"

	"github.com/JoaoVictorVM/ludora/internal/models"
)

// ReviewFormShell renders a blank review form for the selected game.
templ ReviewFormShell(game *models.Game) {
	@ReviewForm(game, 0, "", "")
}

// ReviewForm carries the resolved local game id and, on a rejected submission,
// re-renders with the visitor's input intact plus the reason it was rejected.
templ ReviewForm(game *models.Game, rating int16, comment string, errorMessage string) {
	<form
		id="review-form"
		class="rounded border border-border bg-surface p-4"
		hx-post="/reviews"
		hx-target="#review-form"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="game_id" value={ strconv.FormatInt(game.ID, 10) }/>
		<div class="flex items-center gap-4">
			if game.CoverURL != "" {
				<img src={ game.CoverURL } alt="" class="h-24 w-24 shrink-0 rounded object-cover"/>
			} else {
				<span class="h-24 w-24 shrink-0 rounded bg-border"></span>
			}
			<div class="min-w-0">
				<h2 class="truncate text-lg font-semibold">{ game.Name }</h2>
				if game.ReleaseYear() > 0 {
					<p class="text-sm text-muted">{ strconv.Itoa(game.ReleaseYear()) }</p>
				}
				if game.Developer != "" {
					<p class="text-sm text-muted">{ game.Developer }</p>
				}
			</div>
		</div>
		<div class="mt-4">
			@StarRatingInput(rating)
		</div>
		<div class="mt-4">
			<label for="comentario" class="block text-sm text-muted">Comentário (opcional)</label>
			<textarea
				id="comentario"
				name="comment"
				rows="4"
				maxlength={ strconv.Itoa(models.MaxCommentLength) }
				class="mt-2 w-full rounded border border-border bg-bg px-3 py-2 outline-none focus:border-accent"
			>{ comment }</textarea>
		</div>
		if errorMessage != "" {
			<p role="alert" class="mt-3 text-sm text-accent">
				{ errorMessage }
				if errorMessage == models.DuplicateReviewMessage {
					<a href={ templ.SafeURL("/jogos/" + strconv.FormatInt(game.ID, 10)) } class="underline underline-offset-2">Ver sua review</a>
				}
			</p>
		}
		<button
			type="submit"
			class="mt-4 rounded bg-accent px-4 py-2 font-medium text-bg hover:opacity-90"
		>Publicar</button>
	</form>
}
